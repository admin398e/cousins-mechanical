# ---------------------------------------------------------------------------
# Cousins Mechanical — environment template
#
# Copy to .env for local development:   cp .env.example .env
# For production, do NOT use a .env file — set each value as a Cloudflare secret:
#     wrangler secret put SESSION_PEPPER
#
# .env is gitignored. Never commit real values.
# ---------------------------------------------------------------------------

# === REQUIRED — the site will not start in production without these ==========

# Pepper mixed into every password hash. Generate: openssl rand -hex 32
# Changing this invalidates every existing password. Set it once, keep it safe.
SESSION_PEPPER=

# The admin dashboard password. Generate: openssl rand -hex 32
ADMIN_TOKEN=

# Owner master key — always logs in and can reset 2FA if you lose your phone.
# Store this somewhere separate from ADMIN_TOKEN. Generate: openssl rand -hex 32
OVERRIDE_TOKEN=

# Public site URL, used in password-reset links and booking emails.
SITE_URL=https://cousinsmechanicalservices.co.uk


# === BOOKINGS — needed to actually confirm a job to a customer ===============

# Resend (resend.com) — free 3,000 emails/month. Sends booking confirmations.
RESEND_API_KEY=
# Must be on a domain you have verified in Resend.
MAIL_FROM=bookings@cousinsmechanicalservices.co.uk

# Google Calendar service account — puts every booking on the business calendar.
# Create at console.cloud.google.com, then share the calendar with the service
# account email (Make changes to events).
GCAL_CLIENT_EMAIL=
GCAL_PRIVATE_KEY=
GCAL_CALENDAR_ID=


# === CUSTOMER MESSAGING — pick ONE of these two ==============================

# Option A: WhatsApp Cloud API (cheaper)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# Option B: Twilio SMS
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# The owner's mobile in E.164 — gets alerted on new customer messages.
OWNER_PHONE=


# === VEHICLE LOOKUP ==========================================================

# UK Vehicle Data Global — turns a number plate into make/model/tyre size.
# Without it the reg box still works but falls back to a default tyre size.
UKVD_API_KEY=
# Only set this if you are on a sandbox key.
UKVD_BASE=

# tire.vdim.app — year/make/model fitment lookup.
TIRE_API_KEY=


# === GOOGLE SIGN-IN (optional) ===============================================

# The Firebase *web* config as a single line of JSON. Safe to expose publicly.
# FIREBASE_WEB_CONFIG={"projectId":"...","appId":"...","apiKey":"...","authDomain":"..."}
FIREBASE_WEB_CONFIG=

# Comma-separated Google accounts allowed into the admin portal.
# REQUIRED if you enable Google sign-in — without it, any customer who signs in
# with Google could otherwise claim an admin session.
ADMIN_EMAILS=


# === OPTIONAL ================================================================

# Extra browser origins allowed to call the API (comma-separated).
EXTRA_ORIGINS=
